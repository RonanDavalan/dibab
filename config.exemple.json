{
  "destination": {
    "sous_repertoire_logs": "logs",
    "vide_poches_prefixe": "vide-poches-",
    "repertoire_doublon": "duplicate"
  },

  "arborescence": {
    "personnel": "{personne}/{annee}",
    "professionnel": "{annee}/{categorie}",
    "personne_inconnue": "Commun"
  },

  "inventaire": {
    "exclusions": ["logs", "Archive", "rebut", "duplicate"]
  },

  "executer_sur": [],

  "destinations": {
    "personnel": {
      "racine": "~/Documents/dibab/personnel",
      "systemes_fichiers_acceptes": ["fuse.gocryptfs"],
      "sous_repertoire_classement": "Administratif",
      "sous_repertoire_a_verifier": "TO_CHECK"
    },
    "professionnel": {
      "racine": "~/Documents/dibab/professionnel",
      "systemes_fichiers_acceptes": ["fuse.gocryptfs"],
      "sous_repertoire_classement": "Classement",
      "sous_repertoire_a_verifier": "TO_CHECK"
    }
  },

  "suivi": {
    "securite_jours": 1,
    "premier_scan_jours": 90,
    "rotation": {
      "journal_taille_max_mo": 20,
      "journal_archives_max": 5,
      "sessions_max": 100
    }
  },

  "ollama": {
    "url": "http://localhost:11434",
    "roles": {
      "ocr": [],
      "tri_rapide": [],
      "classification": [],
      "tri_decision": [],
      "objet": []
    },
    "seuil_confiance": 0.4,
    "timeout_secondes": 120,
    "keep_alive_entre_pages": "2m"
  },

  "extraction": {
    "seuil_caracteres_alphanumeriques": 200,
    "pages_ocr": 3,
    "resolution_ocr": 200,
    "taille_max_texte": 20000,
    "repertoire_temporaire": "/dev/shm",
    "timeout_outils_secondes": 60,
    "consigne_ocr": "Transcris fidèlement tout le texte visible de cette page. Rends uniquement le texte."
  },

  "classification": {
    "temperature": 0,
    "num_ctx": 8192,
    "caracteres_max_prompt": 12000,
    "caracteres_max_tri": 3000,
    "seuils_tri_decision": {},
    "keep_alive_entre_documents": "2m",
    "longueur_max_champ": 80,
    "longueur_max_citation": 120,
    "marqueurs_mentions": ["TVA", "SIRET", "SIREN", "CGV", "conditions générales de vente"]
  },

  "mesure": {
    "graine": 20261020,
    "documents_par_coffre": 40,
    "exclusions": ["Archive", "rebut", "duplicate"],
    "taux_erreur_max": 0.02
  },

  "extensions_cibles": [".pdf", ".png", ".jpg", ".jpeg"],

  "nommage": {
    "format": "{date}_{emetteur}_{categorie}{ext}",
    "separateur": "_",
    "date_format": "%Y-%m-%d",
    "date_inconnue_prefixe": "~",
    "emetteur_inconnu": "Inconnu",
    "espaces_vers": "-",
    "prefixe_a_verifier": "[TO_CHECK]",
    "format_a_verifier": "{date}_{emetteur}_{objet}_{origine}{ext}",
    "suffixe_collision": "_{n}"
  },

  "scan": {
    "recursif_par_defaut": true,
    "exclusions_automatiques": ["rebut", "duplicate"],
    "suivre_symlinks": false,
    "ignorer_dotfiles": true
  },

  "sources_locales": [
    {
      "id": "vide-poches-local",
      "chemin": "~/Documents/dibab/vide-poches-local",
      "date_reference": "modification",
      "recursif": true,
      "exclusions": []
    },
    {
      "id": "telechargements-local",
      "chemin": "~/Téléchargements",
      "date_reference": "modification",
      "recursif": true,
      "exclusions": []
    }
  ],

  "ssh": {
    "delai_connexion_secondes": 10,
    "delai_commande_secondes": 120,
    "delai_copie_secondes": 900
  },

  "sources_distantes": [
    {
      "id": "ssh-machine1",
      "alias_ssh": "machine1",
      "vide_poches_destination": "vide-poches-machine1",
      "repertoires": [
        "~/Téléchargements"
      ],
      "date_reference": "modification",
      "recursif": true,
      "exclusions": []
    }
  ],

  "imap": {
    "delai_secondes": 60,
    "taille_max_piece_mo": 25
  },

  "oauth2": {
    "url_autorisation": "https://accounts.google.com/o/oauth2/v2/auth",
    "url_jeton": "https://oauth2.googleapis.com/token",
    "portee": "https://mail.google.com/",
    "marge_renouvellement_secondes": 300,
    "delai_secondes": 30,
    "delai_consentement_secondes": 300,
    "chemins_interdits": ["~/Documents"]
  },

  "sources_imap": [
    {
      "id": "imap-exemple",
      "nom": "exemple",
      "serveur": "imap.exemple.fr",
      "port": 993,
      "ssl": true,
      "authentification": "login",
      "utilisateur": "utilisateur@exemple.fr",
      "mot_de_passe_env": "DIBAB_IMAP_EXEMPLE",
      "dossiers": ["INBOX"],
      "vide_poches_destination": "vide-poches-local",
      "date_reference": "reception"
    },
    {
      "id": "imap-google-exemple",
      "nom": "exemple-google",
      "serveur": "imap.gmail.com",
      "port": 993,
      "ssl": true,
      "authentification": "oauth2",
      "utilisateur": "utilisateur@exemple.fr",
      "client_fichier": "~/.config/dibab/client-google.json",
      "token_fichier": "~/.config/dibab/jeton-google.json",
      "dossiers": ["INBOX"],
      "vide_poches_destination": "vide-poches-google",
      "date_reference": "reception"
    }
  ],

  "personnes": ["Personne1", "Personne2"],

  "categories": [
    "Factures",
    "Aides",
    "Impôts",
    "Banques",
    "Assurances",
    "Handicap",
    "Hopital",
    "Medecin",
    "Vétérinaire",
    "Lycée",
    "Loisir",
    "Emploi",
    "Identité",
    "Domicile",
    "RIB"
  ],

  "pieces_communes": ["Identité", "Domicile", "RIB"],

  "emetteurs_connus": {
    "Assurances": [
      {"nom": "Assurance A", "domaine": "personnel"},
      {"nom": "Assurance B", "domaine": "personnel"},
      {"nom": "Assurance C", "domaine": "mixte"},
      {"nom": "Assurance D", "domaine": "mixte"},
      {"nom": "Assurance E", "domaine": "personnel"}
    ],
    "Banques": [
      {"nom": "Banque A", "domaine": "mixte"},
      {"nom": "Banque B", "domaine": "mixte"},
      {"nom": "Banque C", "domaine": "mixte"},
      {"nom": "Banque D", "domaine": "mixte"}
    ],
    "Factures": [
      {"nom": "Fournisseur A", "domaine": "personnel"},
      {"nom": "Fournisseur B", "domaine": "personnel"},
      {"nom": "Fournisseur C", "domaine": "mixte"},
      {"nom": "Fournisseur D", "domaine": "mixte"},
      {"nom": "Fournisseur E", "domaine": "mixte"},
      {"nom": "Fournisseur F", "domaine": "mixte"}
    ],
    "Aides": [{"nom": "Organisme public", "domaine": "personnel"}],
    "Impôts": [
      {"nom": "Service fiscal", "domaine": "mixte"}
    ]
  }
}
